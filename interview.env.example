# ================================
# 必需配置 - 请复制为 interview.env（已 gitignore，不会入库）并替换为实际值
# ================================

# Provider API Key 加密密钥（必填；请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change-me-to-a-long-random-string
APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=false
APP_AI_CONFIG_ALLOW_FALLBACK_ENCRYPTION_KEY=true

# PostgreSQL（compose 需 --env-file interview.env 指定本文件；库 interview / 用户 postgres / 映射端口 5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RustFS（S3 兼容存储容器；密钥须与下方 APP_STORAGE_ACCESS_KEY/SECRET_KEY 保持一致）
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# S3 兼容存储
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=change-me
APP_STORAGE_SECRET_KEY=change-me
APP_STORAGE_BUCKET=interview

# 语音面试（可选）：多段 STT 合并后再触发面试官
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
